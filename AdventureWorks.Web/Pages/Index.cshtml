@page
@using AdventureWorks.Web
@using Microsoft.Extensions.Options
@model IndexModel
@inject  Settings settings
@{
    ViewData["Home"] = true;
}

<article class="card-columns">
    @foreach (var item in Model.Models)
    {
        <div class="card">
            <img src=@(String.Format("{0}/{1}?{2}", settings.BlobContainerUrl, item.Photo, settings.BlobSASToken)) class="card-img-top" alt="@item.Name">
            <div class="card-body">
                <h5 class="card-title">
                    @item.Name
                </h5>
                <p class="card-text">
                    <small class="text-muted">
                        @item.Description
                    </small>
                </p>
            </div>
            <div class="card-footer">
                <a asp-page="@nameof(DetailsModel)" asp-route-id="@item.id" class="card-link">
                    View Details
                </a>
            </div>
        </div>
    }
</article>